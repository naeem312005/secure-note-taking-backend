{
  "name": "secure-note-taking-backend",
  "version": "1.0.0",
  "description": "Production-ready Secure Note-Taking Application Backend with JWT auth, RBAC, optimized MongoDB indexing, and aggregation pipelines",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node init && node server.js",
    "dev": "node init && nodemon server.js",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "node src/scripts/seed.js",
    "verify:indexes": "node src/scripts/verify-indexes.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "rbac",
    "indexing",
    "aggregation"
  ],
  "author": "CareGuide Senior Engineer",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
